# Public Supabase values (safe in the browser; row-level security protects data)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Server only
STRIPE_WEBHOOK_SECRET=<whsec_...>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only: shared token the webhook passes to public.stripe_sync (only its SHA-256 is stored in the database)
STRIPE_SYNC_TOKEN=<random-64-hex>
